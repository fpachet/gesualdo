{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gesualdo/evaluation_corpus.schema.json",
  "title": "Reduction evaluation corpus file",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "name",
    "description",
    "metadata",
    "corpora",
    "pilot_subsets",
    "validation"
  ],
  "properties": {
    "version": { "const": 1 },
    "name": { "const": "evaluation_corpus" },
    "description": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "required": [
        "generated_from_project",
        "generated_date",
        "extraction_status",
        "source_files_inspected"
      ],
      "properties": {
        "generated_from_project": { "type": "string", "minLength": 1 },
        "generated_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "extraction_status": { "enum": ["draft", "reviewed", "validated"] },
        "source_files_inspected": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "corpora": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/corpus" }
    },
    "pilot_subsets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pilot" }
    },
    "validation": {
      "type": "object",
      "required": ["required_checks"],
      "properties": {
        "required_checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "corpus": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "source_voice_count",
        "baseline_output_dir",
        "report",
        "target"
      ],
      "oneOf": [
        { "required": ["source_manifest"] },
        { "required": ["source_glob"] }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "source_manifest": { "type": "string", "minLength": 1 },
        "source_glob": { "type": "string", "minLength": 1 },
        "source_voice_count": { "type": "integer", "minimum": 1 },
        "baseline_output_dir": { "type": "string", "minLength": 1 },
        "report": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "corpus"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "corpus": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "max_pieces": { "type": "integer", "minimum": 1 },
        "preferred_piece_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
