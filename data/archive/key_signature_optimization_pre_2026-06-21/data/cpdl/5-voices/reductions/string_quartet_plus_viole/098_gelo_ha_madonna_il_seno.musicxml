    <!--========================= Measure 46 =========================-->
    <measure implicit="no" number="46">
      <direction>
        <direction-type>
          <words>The lady has ice in her breast and fire in her face. But I am outwardly ice and inwardly fire.</words>
        </direction-type>
      </direction>
      <direction>
        <direction-type>
          <words>This is happening because Love lives in her face and in my breast and never changes place,</words>
        </direction-type>
      </direction>
      <direction>
        <direction-type>
          <words>so that I would have it in my eyes and she in her heart.</words>
        </direction-type>
      </direction>
      <note>
